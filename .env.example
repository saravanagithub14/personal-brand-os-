# Django Settings
SECRET_KEY=django-insecure-personal-brand-os-dev-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Database Settings
# Set DATABASE_URL for Postgres, or leave blank to fallback to SQLite locally
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_brand_os

# Redis & Celery Settings
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# True runs campaign work in the Django process; useful when developing without Redis.
CELERY_TASK_ALWAYS_EAGER=True

# External AI Provider Keys (for Phase 3)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# News & Social API Keys (for Phase 3 & 4)
NEWS_API_KEY=
YOUTUBE_API_KEY=

# LinkedIn OAuth 2.0 Settings
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback/
# A Fernet key from: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
